{
  "name": "retrosum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build:contracts": "pnpm --filter @retrosum/contracts build",
    "build:money": "pnpm --filter @retrosum/money build",
    "build:shared": "pnpm build:contracts && pnpm build:money",
    "build": "pnpm build:shared && pnpm --filter @retrosum/backend build && pnpm --filter @retrosum/frontend build",
    "dev:backend": "pnpm build:shared && pnpm --filter @retrosum/backend dev",
    "dev:frontend": "pnpm build:shared && pnpm --filter @retrosum/frontend dev",
    "start:backend": "pnpm --filter @retrosum/backend start",
    "start:frontend": "pnpm --filter @retrosum/frontend start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm build:shared && tsc --noEmit -p tsconfig.json && pnpm -r --sort typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:unit": "pnpm build:shared && vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test:unit && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.24.8",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
